{
  "expo": {
    "name": "SOL",
    "slug": "sol",
    "scheme": "sol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sol.checker"
    },
    "android": {
      "package": "app.sol.checker",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SOL uses the camera to photograph your students' handwritten answer sheets.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SOL needs access to your photos so you can upload answer sheets you've already photographed and choose a profile photo.",
          "cameraPermission": "SOL uses the camera to photograph your students' handwritten answer sheets and to take your profile photo.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
