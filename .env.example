# Copy to .env and fill in.

# Supabase (Project Settings → API). Use the publishable key, never the secret/service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Digits in the codes Supabase emails (Authentication → Sign In / Providers → Email → "Email OTP Length").
# 6–10; defaults to 8 when unset.
EXPO_PUBLIC_EMAIL_CODE_LENGTH=8
